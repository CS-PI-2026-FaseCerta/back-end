# Aplicação
NODE_ENV=development
PORT=8080

# Banco de dados (MySQL - XAMPP)
DB_HOST=localhost
DB_PORT=5244
DB_NAME=fasecerta
DB_USER=root
DB_PASSWORD=

# Segurança / Autenticação
# Configure JWT_SECRET com um segredo próprio de pelo menos 32 bytes UTF-8
JWT_SECRET=
# Expiração em milissegundos
JWT_EXPIRATION=3600000
BCRYPT_SALT_ROUNDS=10
